{
  "name": "briz",
  "version": "1.0.0",
  "description": "Hypermedia based frontend library for interactive website",
  "type": "module",
  "main": "dist/Briz.min.js",
  "module": "dist/Briz.min.js",
  "unpkg": "dist/Briz.min.js",
  "jsdelivr": "dist/Briz.min.js",
  "exports": {
    ".": "./dist/Briz.min.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch example/index.js",
    "build": "esbuild src/index.js --bundle --minify --format=esm --outfile=dist/Briz.min.js",
    "test": "vitest"
  },
  "keywords": [
    "hypermedia",
    "frontend",
    "ajax",
    "dom",
    "swap"
  ],
  "author": "Rahmat",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "jsdom": "^28.0.0",
    "vitest": "^4.0.18",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  }
}
