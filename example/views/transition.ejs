<%- include("layouts/headers") %>

<div class="container py-2">
  <h1>Transition</h1>
  <p>Below is a simple demo of using transitions on partial updates. Transitions can only be used for partial DOM updates.</p>

  <form data-ajax
    data-swap="form"
    data-transition
    action="/partials/transition"
    method="get"
  >
    <button type="submit" class="btn btn-primary">Swap Now!</button>
  </form>
</div>

