<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- csrf token for request -->
    <meta name="csrf_token" content="<%= csrf_token %>" />
    
    <!-- load from ../src folder -->
    <script type="module" src="/src/index.js"></script>
    
    <!-- load from public folder -->
    <script type="module" src="/public/script.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/eruda"></script>
    <script>eruda.init();</script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Home</title>
    <style>
      /* State Default (Sembunyi) */
      html::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0;
        background: #c0c;
        z-index: 9999;
        opacity: 0;
        transition: width 0.4s ease-out, opacity 0.2s;
        pointer-events: none;
      }
      
      /* State Loading: Jalan pelan ke 90% */
      html[data-briz-loading="true"]::before {
        opacity: 1;
        width: 90%; 
        /* Kita kasih waktu 10 detik supaya gak mentok duluan kalau koneksi lemot */
        transition: width 10s cubic-bezier(0.1, 0.05, 0.1, 1);
      }
      
      /* State Selesai: Loncat ke 100% */
      html[data-briz-loading="done"]::before {
        opacity: 1;
        width: 100%;
        transition: width 0.2s ease-out; /* Selesai secepat kilat */
      }
    </style>
  </head>
  <body>
